<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: the class countdown as a status-bar chip. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <application>
        <receiver android:name="ph.intportal.glance.NextClassWidget" android:exported="false" android:label="Next class">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/next_class_widget" />
        </receiver>
        <receiver android:name="ph.intportal.glance.GlanceTick" android:exported="false" />
    </application>
</manifest>
